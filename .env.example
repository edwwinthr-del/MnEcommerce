# Copy to .env for Docker Compose. Never commit .env.
COMPOSE_PROJECT_NAME=mora
HTTP_PORT=8080
APP_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:8080
# Enable indexing only after merchant content and deployment checks are complete.
NEXT_PUBLIC_STORE_LIVE=false
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_MERCHANT_NAME=
NEXT_PUBLIC_MERCHANT_ADDRESS=
APP_KEY=
DB_DATABASE=mora
DB_USERNAME=mora
DB_PASSWORD=
# Use true on HTTPS production deployments. Local HTTP must use false.
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:8080
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.test
MAIL_FROM_NAME=Mora
STORE_SHIPPING_CENTS=390
STORE_FREE_SHIPPING_THRESHOLD_CENTS=7500
# Required only with compose.production.yaml; protect the private key directory.
TLS_CERT_DIRECTORY=
